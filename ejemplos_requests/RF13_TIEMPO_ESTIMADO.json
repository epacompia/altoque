          "raw": "{\n  \"stall_id\": 2,\n  \"productos\": [\n    {\n      \"producto_id\": 2,\n      \"cantidad\": 2,\n      \"cremas\": [1]\n    },\n    {\n      \"producto_id\": 3,\n      \"cantidad\": 1\n    }\n  ],\n  \"direccion\": \"Jr. Arequipa 456\",\n  \"with_delivery\": false,\n  \"notas\": \"Sin cebolla\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/pedidos",
