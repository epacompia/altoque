    {
      "name": "RF7 - PRODUCTOS CON IMÁGENES",
      "item": [
        {
          "name": "1. POST - Crear producto con imagen",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer TOKEN_AQUI",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "nombre",
                  "value": "Salchipapas Premium",
                  "type": "text"
                },
                {
                  "key": "descripcion",
                  "value": "Papa crispy con salchichón seleccionado",
                  "type": "text"
                },
                {
                  "key": "precio",
                  "value": "12.50",
                  "type": "text"
                },
                {
                  "key": "categoria_id",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "activo",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "destacado",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "imagen",
                  "type": "file",
                  "src": "/ruta/a/imagen.jpg"
                }
              ]
            },
            "url": {
              "raw": "http://localhost:8000/api/mis-productos",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "mis-productos"]
            }
          },
          "response": []
        },
        {
